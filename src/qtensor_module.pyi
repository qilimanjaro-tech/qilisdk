# Types for the compiled module built from src/qilisdk_cpp/core/qtensor_bindings.cpp.

from typing import Any

import numpy as np
from scipy.sparse import csr_matrix

def _refresh_log_level() -> None: ...

class QTensorCpp:
    def __init__(self, data: object = ..., /) -> None: ...
    @staticmethod
    def identity(nqubits: int, /) -> QTensorCpp: ...
    @staticmethod
    def zero(nqubits: int, /) -> QTensorCpp: ...
    @staticmethod
    def one(nqubits: int, /) -> QTensorCpp: ...
    @staticmethod
    def ket_python(state: object, /) -> QTensorCpp: ...
    @staticmethod
    def bra_python(state: object, /) -> QTensorCpp: ...
    @staticmethod
    def ghz(nqubits: int, /) -> QTensorCpp: ...
    @staticmethod
    def uniform(nqubits: int, /) -> QTensorCpp: ...
    @staticmethod
    def w(nqubits: int, /) -> QTensorCpp: ...
    @staticmethod
    def random(nqubits: int, seed: int, /) -> QTensorCpp: ...
    @staticmethod
    def tensor_product_python(others: list[Any], /) -> QTensorCpp: ...
    def as_scipy(self) -> csr_matrix: ...
    def as_numpy(self) -> np.ndarray: ...
    def as_dense(self) -> np.ndarray: ...
    def as_string(self) -> str: ...
    def storage_format(self) -> str: ...
    def get_nqubits(self) -> int: ...
    def get_shape(self) -> tuple[int, int]: ...
    def coeff(self, row: int, col: int, /) -> complex: ...
    def is_ket(self) -> bool: ...
    def is_bra(self) -> bool: ...
    def is_operator(self) -> bool: ...
    def is_scalar(self) -> bool: ...
    def is_pure(self, atol: float, /) -> bool: ...
    def is_density_matrix(self, atol: float, /) -> bool: ...
    def is_symmetric(self, atol: float, /) -> bool: ...
    def is_self_adjoint(self, atol: float, /) -> bool: ...
    def is_hermitian(self, atol: float, /) -> bool: ...
    def is_positive_semidefinite(self, atol: float, /) -> bool: ...
    def is_unitary(self, atol: float, /) -> bool: ...
    def as_density_matrix(self, atol: float, max_relative_correction: float, /) -> QTensorCpp: ...
    def adjoint(self) -> QTensorCpp: ...
    def transpose(self) -> QTensorCpp: ...
    def conjugate(self) -> QTensorCpp: ...
    def trace(self) -> complex: ...
    def partial_trace_python(self, keep: object, /) -> QTensorCpp: ...
    def norm(self, norm_type: str, /) -> float: ...
    def normalized(self, norm_type: str, /) -> QTensorCpp: ...
    def expectation_value_python(self, other: object, nshots: int, seed: object, /) -> complex: ...
    def add_python(self, other: object, /) -> QTensorCpp: ...
    def sub_python(self, other: object, /) -> QTensorCpp: ...
    def mul_python(self, other: object, /) -> QTensorCpp: ...
    def matmul_python(self, other: object, /) -> QTensorCpp: ...
    def div(self, scalar: complex, /) -> QTensorCpp: ...
    def equals_python(self, other: object, /) -> bool: ...
    def dot_python(self, other: object, /) -> complex: ...
    def commutator_python(self, other: object, /) -> QTensorCpp: ...
    def anticommutator_python(self, other: object, /) -> QTensorCpp: ...
    def pow(self, n: float, /) -> QTensorCpp: ...
    def sqrt(self) -> QTensorCpp: ...
    def log(self) -> QTensorCpp: ...
    def exp(self) -> QTensorCpp: ...
    def inverse(self) -> QTensorCpp: ...
    def rank(self) -> int: ...
    def compute_eigendecomposition(self) -> None: ...
    def get_eigenvalues_python(self) -> list[complex]: ...
    def get_eigenvectors_python(self) -> list[QTensorCpp]: ...
    def entropy_von_neumann(self) -> float: ...
    def entropy_renyi(self, alpha: float, /) -> float: ...
    def magic(self, alpha: float, /) -> float: ...
    def fidelity_python(self, other: object, /) -> float: ...
    def purity(self) -> float: ...
    def probabilities_python(self) -> list[float]: ...
    def sample_python(self, nshots: int, seed: int, /) -> dict[str, int]: ...
    def reset_qubits_python(self, qubits: object, /) -> QTensorCpp: ...
    def permute_python(self, order: object, /) -> QTensorCpp: ...
    def clear_cache(self) -> None: ...
