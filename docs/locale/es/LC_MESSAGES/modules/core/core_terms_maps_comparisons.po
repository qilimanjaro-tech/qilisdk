msgstr ":class:`~qilisdk.core.expression.Cos` para el coseno"

#: ../../modules/core/core_terms_maps_comparisons.rst:168
msgid ":class:`~qilisdk.core.expression.Tan` for tangent"
msgstr ":class:`~qilisdk.core.expression.Tan` para la tangente"

#: ../../modules/core/core_terms_maps_comparisons.rst:169
msgid ":class:`~qilisdk.core.expression.Exp` for exponential"
msgstr ":class:`~qilisdk.core.expression.Exp` para la exponencial"

#: ../../modules/core/core_terms_maps_comparisons.rst:170
msgid ":class:`~qilisdk.core.expression.Log` for logarithm"
msgstr ":class:`~qilisdk.core.expression.Log` para el logaritmo"

