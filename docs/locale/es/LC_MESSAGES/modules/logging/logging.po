msgid ""
"Things worth noting, such as a parameter being ignored. This is the "
"default threshold."
msgstr ""
"Aspectos a tener en cuenta, como que se ignore un parámetro. Este es el "
"umbral por defecto."

#: ../../modules/logging/logging.rst:67
msgid "``ERROR``"
msgstr "``ERROR``"

#: ../../modules/logging/logging.rst:68
msgid "❌"
msgstr "❌"

#: ../../modules/logging/logging.rst:69
