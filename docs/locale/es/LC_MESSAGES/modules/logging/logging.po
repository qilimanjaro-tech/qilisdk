msgstr "Mensajes que indican que una operación se ha completado correctamente."

#: ../../modules/logging/logging.rst:64
msgid "``WARNING``"
msgstr "``WARNING``"

#: ../../modules/logging/logging.rst:65
msgid "🚧"
msgstr "🚧"

